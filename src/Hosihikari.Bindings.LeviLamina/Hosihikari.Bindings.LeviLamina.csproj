<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <RootNamespace>Hosihikari.Bindings.LeviLamina</RootNamespace>
    <AssemblyName>Hosihikari.Bindings.LeviLamina</AssemblyName>
  </PropertyGroup>

  <PropertyGroup>
    <PackageId>Hosihikari.Bindings.LeviLamina</PackageId>
    <Version>26.51.7-r0</Version>
    <Authors>Hosihikari</Authors>
    <Description>Hand-written .NET Idiomatic layer over the LeviLamina LLAPI Interop.</Description>
    <PackageLicenseExpression>LGPL-3.0-or-later</PackageLicenseExpression>
    <RepositoryUrl>https://github.com/Hosihikari/Bindings.LeviLamina</RepositoryUrl>
    <RepositoryType>git</RepositoryType>
    <PackageTags>minecraft;bedrock;bds;levilamina;hosihikari</PackageTags>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="../Hosihikari.Bindings.LeviLamina.Interop/Hosihikari.Bindings.LeviLamina.Interop.csproj" />
  </ItemGroup>

</Project>
